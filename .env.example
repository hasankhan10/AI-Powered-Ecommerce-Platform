# ==============================================================================
# AI-POWERED WHITE-LABEL E-COMMERCE FRAMEWORK — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Duplicate this file as `.env.local` and configure your credentials.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Direct or pooled PostgreSQL connection URL (e.g. Supabase, Neon, AWS RDS)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 2. SUPABASE AUTH & STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 3. AI / COPILOT ENGINE (Google Gemini AI)
# ------------------------------------------------------------------------------
# Used for AI product descriptions, auto-SEO generation, and AI customer support
GEMINI_API_KEY="AIzaSy..."
GOOGLE_GENERATIVE_AI_API_KEY="AIzaSy..."

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Razorpay / Stripe)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."

# ------------------------------------------------------------------------------
# 5. LOGISTICS & FULFILLMENT (Shiprocket API)
# ------------------------------------------------------------------------------
SHIPROCKET_EMAIL="logistics@yourbrand.com"
SHIPROCKET_PASSWORD="your-shiprocket-password"
SHIPROCKET_API_TOKEN=""

# ------------------------------------------------------------------------------
# 6. SITE & WHITE-LABEL DEPLOYMENT
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"
